{
  "name": "novo-site-selecon",
  "private": true,
  "version": "0.1.0",
  "description": "Portal Integrado do Instituto Selecon — monorepo",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "docker:build:web": "docker build -f apps/web/Dockerfile -t selecon-portal-web:dev .",
    "docker:build:api": "docker build -f apps/api/Dockerfile -t selecon-portal-api:dev .",
    "docker:build:worker": "docker build -f apps/worker/Dockerfile -t selecon-portal-worker:dev .",
    "docker:build": "pnpm docker:build:web && pnpm docker:build:api && pnpm docker:build:worker",
    "docker:run:web": "docker run --rm -p 3000:3000 --env-file .env --name selecon-web-dev selecon-portal-web:dev",
    "docker:run:api": "docker run --rm -p 3001:3001 --env-file .env --network host --name selecon-api-dev selecon-portal-api:dev",
    "docker:run:worker": "docker run --rm --env-file .env --network host --name selecon-worker-dev selecon-portal-worker:dev",
    "docker:test": "bash scripts/docker-smoke-test.sh"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "argon2",
      "@prisma/client",
      "@prisma/engines",
      "@scarf/scarf",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
