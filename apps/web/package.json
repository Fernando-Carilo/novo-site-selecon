{
  "name": "@selecon/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p ${WEB_PORT:-3000}",
    "build": "cross-env NODE_ENV=production next build",
    "start": "next start -p ${WEB_PORT:-3000}",
