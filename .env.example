# Copie este arquivo para .env e preencha com valores de desenvolvimento local.
# NUNCA commite um arquivo .env com valores reais, segredos ou credenciais.

# --- Comum ---
NODE_ENV=development
LOG_LEVEL=info

# --- Banco de dados (Postgres local via docker-compose) ---
DATABASE_URL=postgresql://selecon:selecon@localhost:5432/selecon_dev

# --- Cache / filas (Redis local via docker-compose) ---
REDIS_URL=redis://localhost:6379

# --- apps/api ---
API_PORT=3001
# Segredo usado apenas para assinar sessões de desenvolvimento local. Gere um valor
# aleatório próprio; nunca reutilize este exemplo em produção.
DEV_SESSION_SECRET=change-me-in-local-env

# --- apps/web ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Integrações (mock nesta fase — sem credenciais reais) ---
INTEGRATIONS_MODE=mock

# Quando as credenciais reais existirem (fora do escopo desta fase), variáveis como
# MS_GRAPH_CLIENT_ID, MS_GRAPH_CLIENT_SECRET, MS_GRAPH_TENANT_ID, WHATSAPP_ACCESS_TOKEN,
# WHATSAPP_APP_SECRET, CANDIDATE_API_BASE_URL etc. serão adicionadas aqui como apenas
# NOMES, sem valores — os valores reais vivem em Secrets Manager / .env local não commitado.

# --- Conteúdo e canais vindos da Selecon Central (CRM de atendimento) ---------
# Origem de notícias, páginas institucionais e catálogo de concursos (a Central gere as
# publicações e decide quais certames aparecem, com o ProSeleta como base).
# Produção: https://atendimento.selecon.org.br/api  — vazio = páginas mostram estado vazio.
CONTENT_API_URL=
# Lidas em tempo de execução (não no build): o site renderiza por requisição.
# Endereço público da Central: carrega o chat de atendimento (widget) na página /atendimento.
SITE_CENTRAL_URL=
# Canais exibidos em /atendimento e botão flutuante de WhatsApp — só aparecem quando definidos.
SITE_WHATSAPP_NUMBER=
SITE_CONTACT_PHONE=
SITE_CONTACT_EMAIL=
SITE_CONTACT_HOURS=
# Canal de denúncias (ambiente próprio, segregado por sigilo).
SITE_DENUNCIAS_URL=https://denuncias.selecon.org.br
