# Copie este arquivo para .env e preencha com valores de desenvolvimento local.
# NUNCA commite um arquivo .env com valores reais, segredos ou credenciais.

# --- Comum ---
NODE_ENV=development
LOG_LEVEL=info

# --- Banco de dados (Postgres local via docker-compose) ---
DATABASE_URL=postgresql://selecon:selecon@localhost:5432/selecon_dev

# --- Cache / filas (Redis local via docker-compose) ---
REDIS_URL=redis://localhost:6379

# --- apps/api ---
API_PORT=3001
# Origem do frontend permitida por CORS (defesa em profundidade; o fluxo normal é
# via proxy server-to-server em apps/web, que não sofre CORS).
WEB_ORIGIN=http://localhost:3000

# --- apps/web ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
# URL interna usada pelo proxy server-side de apps/web para chamar apps/api
# (nunca exposta ao navegador — diferente de NEXT_PUBLIC_API_URL).
API_INTERNAL_URL=http://localhost:3001

# --- Integrações (mock nesta fase — sem credenciais reais) ---
INTEGRATIONS_MODE=mock

# Quando as credenciais reais existirem (fora do escopo desta fase), variáveis como
# MS_GRAPH_CLIENT_ID, MS_GRAPH_CLIENT_SECRET, MS_GRAPH_TENANT_ID, WHATSAPP_ACCESS_TOKEN,
# WHATSAPP_APP_SECRET, CANDIDATE_API_BASE_URL etc. serão adicionadas aqui como apenas
# NOMES, sem valores — os valores reais vivem em Secrets Manager / .env local não commitado.
