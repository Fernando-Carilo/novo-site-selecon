# Copie este arquivo para .env e preencha com valores de desenvolvimento local.
# NUNCA commite um arquivo .env com valores reais, segredos ou credenciais.

# --- Comum ---
NODE_ENV=development
LOG_LEVEL=info

# --- Banco de dados (Postgres local via docker-compose) ---
DATABASE_URL=postgresql://selecon:selecon@localhost:5432/selecon_dev

# --- Cache / filas (Redis local via docker-compose) ---
REDIS_URL=redis://localhost:6379

# --- apps/api ---
API_PORT=3001
# Segredo usado apenas para assinar sessões de desenvolvimento local. Gere um valor
# aleatório próprio; nunca reutilize este exemplo em produção.
DEV_SESSION_SECRET=change-me-in-local-env

# --- apps/web ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
# URL pública do portal (canonical, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Central de Serviços Selecon (publicações, notícias e filas de atendimento/comercial) ---
# CONTENT_SOURCE=static  → dataset migrado em apps/web/lib/content/data (padrão até o cutover)
# CONTENT_SOURCE=central → lê publicações/notícias da Central (exige CENTRAL_SERVICOS_API_URL)
CONTENT_SOURCE=static
# CENTRAL_SERVICOS_API_URL=https://atendimento.selecon.org.br/api   (local: http://localhost:4100)
# CENTRAL_SERVICOS_API_TOKEN= (opcional; igual ao PORTAL_API_TOKEN da Central, se definido)
CENTRAL_SERVICOS_REVALIDATE_SECONDS=300
# SUBMISSIONS_MODE=mock → formulários (comercial, Fale Conosco, alertas) geram protocolo local;
# SUBMISSIONS_MODE=central → envia para a Central. Em produção, "mock" precisa ser explícito.
SUBMISSIONS_MODE=mock
# Host adicional permitido para imagens remotas (ex.: CDN da Central).
# NEXT_IMAGE_EXTRA_HOST=cdn.exemplo.selecon.org.br

# --- Integrações (mock nesta fase — sem credenciais reais) ---
INTEGRATIONS_MODE=mock

# Quando as credenciais reais existirem (fora do escopo desta fase), variáveis como
# MS_GRAPH_CLIENT_ID, MS_GRAPH_CLIENT_SECRET, MS_GRAPH_TENANT_ID, WHATSAPP_ACCESS_TOKEN,
# WHATSAPP_APP_SECRET, CANDIDATE_API_BASE_URL etc. serão adicionadas aqui como apenas
# NOMES, sem valores — os valores reais vivem em Secrets Manager / .env local não commitado.
